# --- LLM (any OpenAI-compatible provider) ---
# Groq   : https://api.groq.com/openai/v1                           key: https://console.groq.com/keys
# Gemini : https://generativelanguage.googleapis.com/v1beta/openai/  key: https://aistudio.google.com/app/apikey
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_key_here
# Check the provider's models page for current model IDs.
LLM_MODEL=llama-3.3-70b-versatile

# --- Retrieval (models run locally, no key needed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DEFAULT_MODE=hybrid_rerank
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
CANDIDATE_K=20

# --- Storage ---
DATABASE_URL=sqlite:///./data/app.db
CHROMA_DIR=./data/chroma
MAX_UPLOAD_MB=20
